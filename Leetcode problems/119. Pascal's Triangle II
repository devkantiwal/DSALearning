Given an integer rowIndex, return the rowIndexth (0-indexed) row of the Pascal's triangle.

In Pascal's triangle, each number is the sum of the two numbers directly above it as shown:


 

Example 1:

Input: rowIndex = 3
Output: [1,3,3,1]
Example 2:

Input: rowIndex = 0
Output: [1]
Example 3:

Input: rowIndex = 1
Output: [1,1]
 

Constraints:

0 <= rowIndex <= 33
 

Follow up: Could you optimize your algorithm to use only O(rowIndex) extra space?



------------------------------------


class Solution {
    func getRow(_ rowIndex: Int) -> [Int] {
        var finalArray: [[Int]] = []
        var array: [Int] = []
        for x in 0...rowIndex {
            array.removeAll()
            for y in 0...x {
                if y == 0 {
                    array.append(1)
                } else if y == x {
                    array.append(1)
                } else {
                    let lastArray = finalArray[x-1]
                    let sum = lastArray[y] + lastArray[y-1]
                    array.append(sum)
                }
            }
            finalArray.append(array)
        }
        return finalArray[rowIndex]
    }
}


