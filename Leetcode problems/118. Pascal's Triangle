Given an integer numRows, return the first numRows of Pascal's triangle.

In Pascal's triangle, each number is the sum of the two numbers directly above it as shown:


 

Example 1:

Input: numRows = 5
Output: [[1],[1,1],[1,2,1],[1,3,3,1],[1,4,6,4,1]]
Example 2:

Input: numRows = 1
Output: [[1]]
 

Constraints:

1 <= numRows <= 30


---------------------------------

class Solution {
    func generate(_ numRows: Int) -> [[Int]] {
        var arrayFinal: [[Int]] = []
        var num = 1
        var array: [Int] = []
        for x in 0..<numRows {
            array.removeAll()
            for y in 0...x {
                if y == 0 {
                    array.append(1)
                } else if y == x {
                    array.append(1)
                } else {
                    let lastArray = arrayFinal[x-1]
                    let sum = lastArray[y] + lastArray[y-1]
                    array.append(sum)
                }
            }
            arrayFinal.append(array)
        }
        return arrayFinal
    }
}
